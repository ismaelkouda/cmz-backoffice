{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seos://dsl/feature.schema.json",
  "title": "SEOS Feature DSL",
  "type": "object",
  "required": ["feature", "capabilities"],
  "properties": {
    "feature": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string" }
      }
    },
    "actors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["list", "details", "create", "edit", "delete", "action", "select"]
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "type": {
            "type": "string",
            "enum": ["string", "text", "number", "boolean", "date", "enum"]
          },
          "required": { "type": "boolean", "default": false },
          "values": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "properties": {
        "fullText": { "type": "boolean" }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "default": "string" }
            }
          }
        ]
      }
    },
    "pagination": { "type": "boolean" },
    "sorting": { "type": "boolean" },
    "attachments": {
      "type": "object",
      "properties": {
        "upload": { "type": "boolean" }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "map": { "type": "string" }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "base": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "pattern": {
          "type": "string",
          "enum": ["auto", "crud-entity", "action-request"]
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" }
      }
    }
  }
}
