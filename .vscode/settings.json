{
    "cSpell.words": ["resiliate", "Statetreatment"],
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
    "editor.formatOnType": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": false,
    "editor.formatOnSaveMode": "file",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.autoSave": "off",
    "vs-code-prettier-eslint.prettierLast": false,

    "editor.codeActionsOnSave": {
        "source.organizeImports": "never",
        "source.fixAll.eslint": "always",
    },
    "typescript.suggest.autoImports": true,
    "eslint.validate": ["javascript", "typescript", "html"],
    "files.eol": "\n",
    "typescript.tsdk": "node_modules/typescript/libs",
    "[javascript]": {
        "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
        "editor.formatOnSave": true
    },
    "typescript.preferences.quotePreference": "single",
    "javascript.preferences.quotePreference": "single",
    "typescript.preferences.importModuleSpecifierEnding": "none",
    "typescript.preferences.importModuleSpecifierMode": "shortest",
    "typescript.preferences.useAliases": true,
    "workbench.editor.alwaysShowEditorActions": false,
    "workbench.editor.autoLockGroups": {
        "workbench.editorinputs.searchEditorInput": true,
        "default": true
    },
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.settings.openDefaultKeybindings": false,
    "workbench.settings.openDefaultSettings": false,
    "workbench.editor.enablePreviewFromCodeNavigation": false,
    
}
