{
    "trailingComma": "es5",
    "printWidth": 80,
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 4,
    "semi": true,
    "bracketSpacing": true,
    "importOrder": [
        "^node:",
        "^@angular",
        "^rxjs",
        "^[./]"
    ],
    "importOrderSeparateGroups": true,
    "importOrderSortSpecifiers": true
}